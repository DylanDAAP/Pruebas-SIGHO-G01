<c:Actors>
<o:Actor Id="o24">
<a:ObjectID>E79C78E0-2F52-4C61-B147-E1EFCC3ECFFF</a:ObjectID>
<a:Name>Personal de admisión</a:Name>
<a:Code>ACT02_PERSONAL_ADMISION</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-02. Registra pacientes, verifica datos, gestiona la llegada y programa citas. Formación técnica o administrativa.</a:Description>
</o:Actor>
</c:Actors>
<c:UseCases>
<o:UseCase Id="o25">
<a:ObjectID>BC425FC0-58CD-4CBE-A295-ADF229CBB0F7</a:ObjectID>
<a:Name>Registrar llegada del paciente</a:Name>
<a:Code>UC02_REGISTRAR_LLEGADA_PACIENTE</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>UC-02 / ECUD2 / RF-002 / OBJ-01. Actor: personal de admisión.
El sistema debe permitir registrar la llegada de un paciente, con cita programada o sin cita (demanda espontánea), dejando su estado de atención visible para el médico.
Reglas: RN-15 (usuario, fecha y hora), RNF-001 (tiempo de respuesta inmediato).</a:Description>
</o:UseCase>
<o:UseCase Id="o26">
<a:ObjectID>748B954E-C981-4013-8940-D6A6FCB47708</a:ObjectID>
<a:Name>Consultar citas del día</a:Name>
<a:Code>UC02_01_CONSULTAR_CITAS_DIA</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD2 - Consultar citas del día del paciente (RF-002 criterio 1). Permite identificar al paciente y listar las citas programadas vigentes para la fecha actual.</a:Description>
</o:UseCase>
<o:UseCase Id="o27">
<a:ObjectID>DE8A82F0-E928-421F-ABFA-65DE70D01464</a:ObjectID>
<a:Name>Registrar llegada con cita</a:Name>
<a:Code>UC02_02_REGISTRAR_LLEGADA_CON_CITA</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD2 - Registrar llegada con cita (RF-002 criterio 1). Registra la llegada con fecha y hora exacta, actualiza el estado de la cita a &#39;presente/en espera&#39; y la deja visible en la bandeja del médico.</a:Description>
</o:UseCase>
<o:UseCase Id="o28">
<a:ObjectID>0A0E1C8F-F2C5-464A-8265-698AA7261E8E</a:ObjectID>
<a:Name>Registrar llegada sin cita</a:Name>
<a:Code>UC02_03_REGISTRAR_LLEGADA_SIN_CITA</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD2 - Registrar llegada sin cita (RF-002 criterio 2). Crea un episodio de atención no programada asociado al paciente identificado, asignando turno o derivando a triaje/admisión.</a:Description>
</o:UseCase>
<o:UseCase Id="o29">
<a:ObjectID>42514B0E-1B23-4536-81C7-39125CC60AAE</a:ObjectID>
<a:Name>Validar estado de la cita</a:Name>
<a:Code>UC02_04_VALIDAR_ESTADO_CITA</a:Code>
<a:CreationDate>1793764010</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764010</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD2 - Validar estado de la cita (RF-002 criterio 3). El sistema valida que la cita esté programada o confirmada, y rechaza registrar la llegada si la cita fue cancelada o ya fue atendida.</a:Description>
</o:UseCase>
</c:UseCases>
