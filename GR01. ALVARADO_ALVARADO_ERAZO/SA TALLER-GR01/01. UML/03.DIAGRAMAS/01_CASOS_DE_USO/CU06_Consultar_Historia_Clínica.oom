<c:Actors>
<o:Actor Id="o33">
<a:ObjectID>F4004259-2084-4027-937C-5191D2E0C3A9</a:ObjectID>
<a:Name>Médico</a:Name>
<a:Code>ACT03_MEDICO</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-03. Consulta el historial clínico completo del paciente para diagnóstico y tratamiento.</a:Description>
</o:Actor>
<o:Actor Id="o34">
<a:ObjectID>4212076C-5A59-40A4-B1F1-707FD04D45BE</a:ObjectID>
<a:Name>Enfermero</a:Name>
<a:Code>ACT04_ENFERMERO</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-04. Consulta antecedentes, alergias y evolución clínica en el ámbito de sus competencias.</a:Description>
</o:Actor>
</c:Actors>
<c:UseCases>
<o:UseCase Id="o35">
<a:ObjectID>D38EA399-383B-44DB-949A-0C76D8263EC8</a:ObjectID>
<a:Name>Consultar historia clínica</a:Name>
<a:Code>UC06_CONSULTAR_HISTORIA_CLINICA</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>UC-06 / ECUD6 / RF-008 / OBJ-04. Actores: médico y enfermero.
Permite consultar el expediente cronológico del paciente con antecedentes, alergias, consultas, emergencias, hospitalizaciones, prescripciones, laboratorios e imágenes según los permisos del rol.
Reglas: RN-14 (confidencialidad y control de acceso), RN-15 (registro obligatorio de auditoría en cada acceso), no alteración de registros de otros profesionales.</a:Description>
</o:UseCase>
<o:UseCase Id="o36">
<a:ObjectID>AA829EE3-6976-4E6D-9A2A-D5330F836FF4</a:ObjectID>
<a:Name>Buscar expediente de paciente</a:Name>
<a:Code>UC06_01_BUSCAR_EXPEDIENTE</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD6 - Buscar expediente (RF-008). Búsqueda por cédula/documento, identificador único o nombres del paciente.</a:Description>
</o:UseCase>
<o:UseCase Id="o37">
<a:ObjectID>1472E756-F1BC-47E5-8BCD-51789537F8C0</a:ObjectID>
<a:Name>Visualizar historial de atenciones</a:Name>
<a:Code>UC06_02_VISUALIZAR_HISTORIAL</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD6 - Visualizar historial cronológico (RF-008 criterio 1). Muestra la línea de tiempo de episodios asistenciales (consultas externas, urgencias, hospitalizaciones y cirugías).</a:Description>
</o:UseCase>
<o:UseCase Id="o38">
<a:ObjectID>94031AF7-D2AA-4705-98AD-0C9074BE7DB9</a:ObjectID>
<a:Name>Consultar antecedentes y diagnósticos</a:Name>
<a:Code>UC06_03_CONSULTAR_ANTECEDENTES_DIAG</a:Code>
<a:CreationDate>1793764016</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764016</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD6 - Consultar antecedentes y diagnósticos (RF-008 criterio 1). Presenta problemas de salud activos, alergias verificadas y diagnósticos históricos.</a:Description>
</o:UseCase>
<o:UseCase Id="o39">
