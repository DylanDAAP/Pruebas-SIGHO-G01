<c:Actors>
<o:Actor Id="o28">
<a:ObjectID>BF87FA79-51A1-4B29-B9D1-596A3B145C7A</a:ObjectID>
<a:Name>Médico</a:Name>
<a:Code>ACT03_MEDICO</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-03. Registra atenciones, notas clínicas, diagnósticos, órdenes y prescripciones.</a:Description>
</o:Actor>
<o:Actor Id="o29">
<a:ObjectID>BCB0A868-E52F-4C78-80E2-4529CD2A849D</a:ObjectID>
<a:Name>Enfermero</a:Name>
<a:Code>ACT04_ENFERMERO</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-04. Apoya en el registro de triaje de emergencia y preparación del paciente.</a:Description>
</o:Actor>
</c:Actors>
<c:UseCases>
<o:UseCase Id="o30">
<a:ObjectID>C638C5FC-19F3-416E-AB06-9CA100AB4136</a:ObjectID>
<a:Name>Registrar atención clínica</a:Name>
<a:Code>UC04_REGISTRAR_ATENCION_CLINICA</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>UC-04 / ECUD4 / RF-005, RF-006 / OBJ-03. Actores: médico y enfermero.
Permite registrar la atención de consulta externa, gestionar la nota clínica (en elaboración vs. finalizada) y registrar atenciones de emergencia y triaje con identificación provisional si es requerida.
Reglas: RN-03 (inmutabilidad de nota finalizada; corrección mediante adenda trazable), RN-14 (confidencialidad), RN-15 (usuario, fecha y hora).</a:Description>
</o:UseCase>
<o:UseCase Id="o31">
<a:ObjectID>3C97ECEA-FB65-4760-B03C-2F165D5F398A</a:ObjectID>
<a:Name>Registrar consulta externa</a:Name>
<a:Code>UC04_01_REGISTRAR_CONSULTA_EXTERNA</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD4 - Registrar atención de consulta externa (RF-005 criterio 1). Registra motivo de consulta, síntomas, evolución, antecedentes, exploración física, diagnósticos CIE y plan de tratamiento.</a:Description>
</o:UseCase>
<o:UseCase Id="o32">
<a:ObjectID>EE037BFE-4EC1-4B23-8032-F4C687982ACA</a:ObjectID>
<a:Name>Registrar triaje y emergencia</a:Name>
<a:Code>UC04_02_REGISTRAR_EMERGENCIA_TRIAJE</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD4 - Registrar atención de emergencia y triaje (RF-006 criterios 1, 2 y 3). Permite inicio sin cita y con identificación provisional, asignando prioridad según protocolo de triaje del hospital.</a:Description>
</o:UseCase>
<o:UseCase Id="o33">
<a:ObjectID>3A2197BF-DAD1-4270-9353-2172A55CE77A</a:ObjectID>
<a:Name>Finalizar nota clínica</a:Name>
<a:Code>UC04_03_FINALIZAR_NOTA_CLINICA</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD4 - Finalizar nota clínica (RF-005 criterios 2 y 3). Cierra la edición de la nota; una vez finalizada, no puede ser modificada ni borrada directamente (RN-03).</a:Description>
</o:UseCase>
<o:UseCase Id="o34">
<a:ObjectID>DAE12284-7405-477F-91D4-5A666611B98A</a:ObjectID>
<a:Name>Corregir nota clínica (adenda)</a:Name>
<a:Code>UC04_04_CORREGIR_NOTA_CLINICA</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD4 - Corregir nota finalizada (RF-005 criterio 4). Genera un registro complementario vinculado (adenda) con motivo, fecha, hora y usuario, manteniendo intacta y visible la nota original.</a:Description>
</o:UseCase>
<o:UseCase Id="o35">
<a:ObjectID>00EA2E87-0D35-407C-B22E-EE29F78D6DD8</a:ObjectID>
<a:Name>Emitir órdenes clínicas y disposición</a:Name>
<a:Code>UC04_05_EMITIR_ORDENES_DISPOSICION</a:Code>
<a:CreationDate>1793764013</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764013</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD4 - Emitir órdenes clínicas y disposición final (RF-005 criterio 5, RF-006 criterio 4). Permite derivar a exámenes, imágenes, prescripción o disponer alta, hospitalización o traslado.</a:Description>
</o:UseCase>
</c:UseCases>
