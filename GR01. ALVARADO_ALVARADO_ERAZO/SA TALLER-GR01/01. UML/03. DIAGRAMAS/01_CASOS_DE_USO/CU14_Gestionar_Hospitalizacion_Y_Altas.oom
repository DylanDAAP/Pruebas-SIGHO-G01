<c:UseCases>
<o:UseCase Id="o30">
<a:ObjectID>04225776-49F7-4CC6-9AD4-3156AC16BE32</a:ObjectID>
<a:Name>Gestionar hospitalización y altas</a:Name>
<a:Code>GESTIONAR_HOSPITALIZACION_ALTAS</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>ECUD14: Permite registrar el ingreso hospitalario de un paciente, asignarle una cama, dar seguimiento a su estancia y registrar el alta.</a:Comment>
</o:UseCase>
<o:UseCase Id="o32">
<a:ObjectID>19E49643-EA76-4785-95B0-65DBFF8FEFF8</a:ObjectID>
<a:Name>Buscar y seleccionar paciente</a:Name>
<a:Code>BUSCAR_Y_SELECCIONAR_PACIENTE</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El usuario busca y selecciona al paciente; el sistema muestra sus datos y atenciones.</a:Comment>
</o:UseCase>
<o:UseCase Id="o34">
<a:ObjectID>C6B5C59D-C71D-49CA-8478-7D4889975AB0</a:ObjectID>
<a:Name>Registrar ingreso hospitalario</a:Name>
<a:Code>REGISTRAR_INGRESO_HOSPITALARIO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>Se registra el ingreso con servicio, cama y datos requeridos.</a:Comment>
</o:UseCase>
<o:UseCase Id="o36">
<a:ObjectID>3EAFF7A2-5574-4747-A330-F25329325963</a:ObjectID>
<a:Name>Validar disponibilidad de cama</a:Name>
<a:Code>VALIDAR_DISPONIBILIDAD_DE_CAMA</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema valida la información y la disponibilidad de la cama.</a:Comment>
</o:UseCase>
<o:UseCase Id="o38">
<a:ObjectID>222F9574-5CA1-444B-80DE-A031566FF963</a:ObjectID>
<a:Name>Registrar alta con indicaciones de egreso</a:Name>
<a:Code>REGISTRAR_ALTA_CON_INDICACIONES_DE_EGRESO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El médico registra el alta; el sistema cierra la hospitalización y libera la cama.</a:Comment>
</o:UseCase>
<o:UseCase Id="o40">
<a:ObjectID>CF4F8417-BEF9-4053-9D43-A72268751F75</a:ObjectID>
<a:Name>Actualizar estado de la cama</a:Name>
<a:Code>ACTUALIZAR_ESTADO_DE_LA_CAMA</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema actualiza el estado de la cama al ingresar o dar el alta.</a:Comment>
</o:UseCase>
<o:UseCase Id="o42">
<a:ObjectID>8A4BF63B-8ABD-48F6-9293-B94AE1B1BE92</a:ObjectID>
<a:Name>Indicar campos incompletos</a:Name>
<a:Code>INDICAR_CAMPOS_INCOMPLETOS</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema indica los campos que deben completarse.</a:Comment>
</o:UseCase>
<o:UseCase Id="o44">
<a:ObjectID>94FA7735-0A2A-4049-A745-CA9F365C4A6D</a:ObjectID>
<a:Name>Informar paciente ya hospitalizado</a:Name>
<a:Code>INFORMAR_PACIENTE_YA_HOSPITALIZADO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema informa que existe una hospitalización activa.</a:Comment>
</o:UseCase>
<o:UseCase Id="o46">
<a:ObjectID>A46F7DEE-0621-47AD-A1FC-7373B2FA7B76</a:ObjectID>
<a:Name>Informar sin camas disponibles</a:Name>
<a:Code>INFORMAR_SIN_CAMAS_DISPONIBLES</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema informa que no hay camas libres en el servicio seleccionado.</a:Comment>
</o:UseCase>
<o:UseCase Id="o48">
<a:ObjectID>58B32947-585F-4C79-BFF3-F02C5C417DDC</a:ObjectID>
<a:Name>Informar error de registro</a:Name>
<a:Code>INFORMAR_ERROR_DE_REGISTRO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
