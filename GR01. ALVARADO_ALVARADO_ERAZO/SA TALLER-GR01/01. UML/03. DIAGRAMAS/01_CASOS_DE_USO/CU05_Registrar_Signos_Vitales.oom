<c:Actors>
<o:Actor Id="o24">
<a:ObjectID>BCBC6AC5-BB1A-4DCD-ACB8-BC1D5B3B961A</a:ObjectID>
<a:Name>Enfermero</a:Name>
<a:Code>ACT04_ENFERMERO</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ACT-04. Registra signos vitales, cuidados y actividades de enfermería. Formación en enfermería.</a:Description>
</o:Actor>
</c:Actors>
<c:UseCases>
<o:UseCase Id="o25">
<a:ObjectID>C5F41A15-80CC-4EF2-AB31-66EEF3834380</a:ObjectID>
<a:Name>Registrar signos vitales</a:Name>
<a:Code>UC05_REGISTRAR_SIGNOS_VITALES</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>UC-05 / ECUD5 / RF-007 / OBJ-03. Actor: enfermero.
Permite registrar los signos vitales del paciente asociados a una atención (presión arterial, frecuencia cardíaca, frecuencia respiratoria, temperatura, saturación de O2, peso, talla, IMC).
Reglas: RN-15 (usuario, fecha y hora), validación numérica y de unidades, no eliminación de mediciones (corrección trazable).</a:Description>
</o:UseCase>
<o:UseCase Id="o26">
<a:ObjectID>AB54C409-6A0A-4926-8CE1-EFC8AEC3F2B4</a:ObjectID>
<a:Name>Consultar pacientes en espera</a:Name>
<a:Code>UC05_01_CONSULTAR_PACIENTES_ESPERA</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD5 - Consultar pacientes en espera (RF-007 criterio 1). Muestra la lista de pacientes con llegada registrada pendientes de toma de signos vitales.</a:Description>
</o:UseCase>
<o:UseCase Id="o27">
<a:ObjectID>D0D50BCE-5262-4DAD-986A-0596BC5F5202</a:ObjectID>
<a:Name>Ingresar signos vitales</a:Name>
<a:Code>UC05_02_INGRESAR_SIGNOS_VITALES</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD5 - Ingresar signos vitales (RF-007 criterios 1 y 2). Captura valores de presión arterial, pulso, respiración, temperatura, oximetría y antropometría con sus unidades.</a:Description>
</o:UseCase>
<o:UseCase Id="o28">
<a:ObjectID>235018F4-2BD6-4BD5-BBF9-6772968A93A1</a:ObjectID>
<a:Name>Validar rangos y alertas</a:Name>
<a:Code>UC05_03_VALIDAR_RANGOS_ALERTAS</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD5 - Validar rangos (RF-007 criterio 2 / flujo alternativo). Valida que los datos sean coherentes y numéricos, advirtiendo al enfermero si hay valores fuera de rango fisiológico.</a:Description>
</o:UseCase>
<o:UseCase Id="o29">
<a:ObjectID>EF2D39D3-08F4-44CB-965B-33241E2C6F1B</a:ObjectID>
<a:Name>Corregir signos vitales</a:Name>
<a:Code>UC05_04_CORREGIR_SIGNOS_VITALES</a:Code>
<a:CreationDate>1793764014</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764014</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD5 - Corregir signos vitales (RF-007 criterio 3). Registra una rectificación vinculada con el motivo y la nueva medición, sin borrar la evidencia original.</a:Description>
</o:UseCase>
</c:UseCases>
