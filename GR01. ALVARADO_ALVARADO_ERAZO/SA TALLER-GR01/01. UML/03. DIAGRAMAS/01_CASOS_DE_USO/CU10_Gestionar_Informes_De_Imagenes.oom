<c:UseCases>
<o:UseCase Id="o30">
<a:ObjectID>4478FD77-1568-4B82-8A25-A27FAB1567A0</a:ObjectID>
<a:Name>Gestionar informes de imágenes</a:Name>
<a:Code>GESTIONAR_INFORMES_IMAGENES</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>ECUD10: Permite al profesional de imágenes registrar, revisar y emitir el informe de un estudio realizado, y al médico solicitante consultarlo una vez emitido.</a:Comment>
</o:UseCase>
<o:UseCase Id="o32">
<a:ObjectID>803E8FD2-BB12-4C8C-B23B-629E684BC1A4</a:ObjectID>
<a:Name>Seleccionar estudio pendiente de informe</a:Name>
<a:Code>SELECCIONAR_ESTUDIO_PENDIENTE_DE_INFORME</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema muestra los estudios realizados pendientes de informe y el profesional selecciona uno.</a:Comment>
</o:UseCase>
<o:UseCase Id="o34">
<a:ObjectID>DBD2AB89-06B8-4012-A93D-A4660D9B7362</a:ObjectID>
<a:Name>Revisar imágenes del estudio</a:Name>
<a:Code>REVISAR_IMAGENES_DEL_ESTUDIO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema muestra datos del paciente, la solicitud y las imágenes asociadas.</a:Comment>
</o:UseCase>
<o:UseCase Id="o36">
<a:ObjectID>98DB93B3-4D4F-4EFD-A300-92AC667E2C9C</a:ObjectID>
<a:Name>Registrar hallazgos y conclusión</a:Name>
<a:Code>REGISTRAR_HALLAZGOS_Y_CONCLUSION</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El profesional registra los hallazgos y la conclusión del estudio.</a:Comment>
</o:UseCase>
<o:UseCase Id="o38">
<a:ObjectID>7121D1BD-9F95-48FF-9D81-30CA6FDFD82A</a:ObjectID>
<a:Name>Validar información obligatoria</a:Name>
<a:Code>VALIDAR_INFORMACION_OBLIGATORIA</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema valida que la información obligatoria esté completa.</a:Comment>
</o:UseCase>
<o:UseCase Id="o40">
<a:ObjectID>29B4A89D-92D6-474C-9E7F-9A2BADE7205F</a:ObjectID>
<a:Name>Emitir informe y actualizar estado</a:Name>
<a:Code>EMITIR_INFORME_Y_ACTUALIZAR_ESTADO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>Se registra el informe, el estudio pasa a informado y queda disponible para el médico.</a:Comment>
</o:UseCase>
<o:UseCase Id="o42">
<a:ObjectID>77FE1277-CD38-4499-B0AA-6BFC8586040C</a:ObjectID>
<a:Name>Consultar informe del estudio</a:Name>
<a:Code>CONSULTAR_INFORME_DEL_ESTUDIO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El médico solicitante consulta el informe cuando el rol esté autorizado.</a:Comment>
</o:UseCase>
<o:UseCase Id="o44">
<a:ObjectID>D78EEB47-FD06-46CB-A35C-485170175593</a:ObjectID>
<a:Name>Indicar campos incompletos</a:Name>
<a:Code>INDICAR_CAMPOS_INCOMPLETOS</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema indica los campos que deben completarse.</a:Comment>
</o:UseCase>
<o:UseCase Id="o46">
<a:ObjectID>AF0D4E66-5EDF-40E9-A9DF-C1D65D9D36B8</a:ObjectID>
<a:Name>Bloquear emisión sin imágenes</a:Name>
<a:Code>BLOQUEAR_EMISION_SIN_IMAGENES</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>Estudio sin imágenes asociadas: no se permite emitir el informe hasta que existan imágenes.</a:Comment>
</o:UseCase>
<o:UseCase Id="o48">
<a:ObjectID>C1A0B213-B53E-4F97-98AE-4EAFBF41A609</a:ObjectID>
<a:Name>Informar error de registro</a:Name>
<a:Code>INFORMAR_ERROR_DE_REGISTRO</a:Code>
<a:CreationDate>1793793600</a:CreationDate>
<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El sistema informa que no fue posible guardar el informe.</a:Comment>
</o:UseCase>
