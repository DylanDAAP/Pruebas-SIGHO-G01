</c:Actors>
<c:UseCases>
<o:UseCase Id="o41">
<a:ObjectID>4A298AF8-E202-4AC2-8AED-DEED20C9D4CC</a:ObjectID>
<a:Name>Gestionar citas</a:Name>
<a:Code>UC03_GESTIONAR_CITAS</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>UC-03 / ECUD3 / RF-003, RF-004 / OBJ-02. Actores: personal de admisión, médico y director hospitalario.
Permite consultar disponibilidad y agendas, programar, confirmar, cancelar y reprogramar citas médicas, y administrar especialidades, profesionales, horarios y consultorios habilitados.
Estados: programada, confirmada, atendida, cancelada, reprogramada, inasistencia.
Reglas: RN-02 (sin solapamiento de horario de profesional ni de consultorio), RN-15 (usuario, fecha, hora y motivo de cambio).</a:Description>
</o:UseCase>
<o:UseCase Id="o42">
<a:ObjectID>52C1ADED-7D4B-4A6D-82BF-5DB433D2523F</a:ObjectID>
<a:Name>Consultar disponibilidad y agendas</a:Name>
<a:Code>UC03_01_CONSULTAR_DISPONIBILIDAD</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Consultar disponibilidad y agendas (RF-003 criterios 1 y 5). Permite visualizar la agenda diaria de un profesional, las citas por especialidad y los turnos libres en consultorios.</a:Description>
</o:UseCase>
<o:UseCase Id="o43">
<a:ObjectID>3A97BE68-5B33-4019-AE71-8495B75822B5</a:ObjectID>
<a:Name>Programar cita médica</a:Name>
<a:Code>UC03_02_PROGRAMAR_CITA</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Programar cita médica (RF-003 criterios 1 y 2). Registra una nueva cita médica dentro de la disponibilidad del médico y consultorio, evitando solapamientos.</a:Description>
</o:UseCase>
<o:UseCase Id="o44">
<a:ObjectID>51CC2D81-043A-47E3-A23E-33FA862EE2E7</a:ObjectID>
<a:Name>Reprogramar cita médica</a:Name>
<a:Code>UC03_03_REPROGRAMAR_CITA</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Reprogramar cita médica (RF-003 criterios 2 y 4). Cambia fecha/hora de una cita existente conservando la cita original con su motivo, usuario, fecha y hora de cambio.</a:Description>
</o:UseCase>
<o:UseCase Id="o45">
<a:ObjectID>8D8A83F7-E82B-44CF-99AA-BCDAA9D9BFCD</a:ObjectID>
<a:Name>Cancelar cita médica</a:Name>
<a:Code>UC03_04_CANCELAR_CITA</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Cancelar cita médica (RF-003 criterio 4). Cambia el estado a cancelada con registro del motivo, fecha, hora y usuario responsable, liberando el horario en la agenda.</a:Description>
</o:UseCase>
<o:UseCase Id="o46">
<a:ObjectID>FD3B38B4-E729-4585-9AD3-3BB9542FA7AA</a:ObjectID>
<a:Name>Confirmar cita médica</a:Name>
<a:Code>UC03_05_CONFIRMAR_CITA</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Confirmar cita médica (RF-003 criterio 3). Actualiza el estado de la cita a confirmada previo a la fecha de atención.</a:Description>
</o:UseCase>
<o:UseCase Id="o47">
<a:ObjectID>949F65BA-D840-40A8-9BC4-A62CDBBDB925</a:ObjectID>
<a:Name>Administrar agendas y horarios</a:Name>
<a:Code>UC03_06_ADMINISTRAR_AGENDAS_HORARIOS</a:Code>
<a:CreationDate>1793764011</a:CreationDate>
<a:Creator>ISAAC</a:Creator>
<a:ModificationDate>1793764011</a:ModificationDate>
<a:Modifier>ISAAC</a:Modifier>
<a:Description>ECUD3 - Administrar especialidades, profesionales, horarios y consultorios (RF-004). Función del Director Hospitalario. Crea, actualiza y desactiva turnos y consultorios; lista citas afectadas si se reduce un horario.</a:Description>
</o:UseCase>
</c:UseCases>
