<a:Creator>USUARIO</a:Creator>
<a:ModificationDate>1793793600</a:ModificationDate>
<a:Modifier>USUARIO</a:Modifier>
<a:Comment>El médico busca y selecciona al paciente; el sistema muestra sus datos y atenciones.</a:Comment>
</o:UseCase>
<o:UseCase Id="o34">
<a:ObjectID>7B222CD8-BBBF-4EE7-8404-E6BDA907A598</a:ObjectID>
